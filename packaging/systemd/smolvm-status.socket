[Unit]
Description=Sandbox Platform native machine status query
# The runtime creates the socket directory after basic.target.
DefaultDependencies=no
After=smolvm-serve.service
Requires=smolvm-serve.service
PartOf=smolvm-serve.service
Conflicts=shutdown.target
Before=shutdown.target

[Socket]
ListenStream=/run/smolvm-platform/status.sock
SocketUser=root
SocketGroup=sandbox-control
SocketMode=0660
Accept=yes
RemoveOnStop=yes
MaxConnections=16

[Install]
WantedBy=multi-user.target
