#!/bin/sh
set -eu
umask 077
install -d -m 0700 /run/sandbox-taskd /var/lib/sandbox-taskd /run/sshd /root/.ssh
install -d -m 0755 /workspace
exec 9>/run/sandbox-taskd/supervisor.lock
flock -n 9 || exit 0
if [ ! -f /var/lib/sandbox-taskd/installation.json ]; then
    tmp=$(mktemp /var/lib/sandbox-taskd/.installation.XXXXXX)
    cat /usr/local/share/sandbox-managed/installation.json >"$tmp"
    sync "$tmp"
    mv "$tmp" /var/lib/sandbox-taskd/installation.json
    sync -f /var/lib/sandbox-taskd
fi
exec /usr/bin/runsvdir /usr/local/share/sandbox-managed/services </dev/null >/dev/null 2>&1
