[Unit]
Description=Sandbox-managed SSH endpoint
After=network.target
ConditionPathExists=/etc/ssh/sandbox-managed/host_ed25519_key

[Service]
Type=exec
ExecStartPre=/usr/bin/install -d -m 0755 /run/sshd
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sandbox-managed/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/ssh/sandbox-managed/sshd_config
KillMode=control-group
Restart=on-failure

[Install]
WantedBy=multi-user.target
